# ============================================================
# Payment Service — Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ============================================================

# ---- App ----
NODE_ENV=development
# 'production' enforces HTTPS-only assumptions & disables verbose errors
PORT=3000
GRPC_URL=0.0.0.0:5000
GRPC_PACKAGE=payment

# ---- Paystack ----
# Secret key: NEVER log or expose this. Server-side only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_PATH=/webhooks/paystack
# Comma-separated list of Paystack's published webhook source IPs.
# See https://paystack.com/docs/payments/webhooks/#ip-whitelisting
PAYSTACK_WEBHOOK_IP_ALLOWLIST=52.31.139.75,52.49.173.169,52.214.14.220
# Set to "false" to disable IP allow-listing (e.g. behind a trusted proxy/tunnel in dev)
PAYSTACK_WEBHOOK_IP_ALLOWLIST_ENABLED=true

# ---- Database (Prisma / Postgres) ----
DATABASE_URL=postgresql://payment_user:payment_pass@localhost:5432/payment_service?schema=public

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=payment.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_PREFETCH_COUNT=10

# ---- gRPC security ----
# Shared secret sent as gRPC metadata ("authorization") by trusted callers.
# Rotate regularly; prefer mTLS in production (see GRPC_TLS_* below).
GRPC_SHARED_SECRET=change-me-to-a-long-random-string
# Enable mTLS for the gRPC server. When true, CERT paths below are required.
GRPC_TLS_ENABLED=false
GRPC_TLS_CERT_PATH=./certs/server-cert.pem
GRPC_TLS_KEY_PATH=./certs/server-key.pem
GRPC_TLS_CA_PATH=./certs/ca-cert.pem

# ---- Rate limiting ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30
WEBHOOK_THROTTLE_TTL_MS=60000
WEBHOOK_THROTTLE_LIMIT=60

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ---- Secrets management (future-ready) ----
# When SECRETS_PROVIDER is not "env", the ConfigModule loader delegates to
# the corresponding provider adapter (implement in src/config/secrets/*).
SECRETS_PROVIDER=env
# AWS_SECRETS_MANAGER_SECRET_ID=payment-service/prod
# AWS_REGION=us-east-1
# VAULT_ADDR=https://vault.internal:8200
# VAULT_SECRET_PATH=secret/data/payment-service

# ---- Logging ----
LOG_LEVEL=info

# ---- Observability ----
# Bearer/x-metrics-token required to read GET /metrics. Required in
# production (the service refuses to serve /metrics without it there);
# optional in development for easy local Prometheus scraping.
METRICS_ACCESS_TOKEN=change-me-to-a-long-random-string
